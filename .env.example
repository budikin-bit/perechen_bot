# Токен бота из MasterBot (обязательно)
MAX_BOT_TOKEN=

# Необязательно:
# MAX_API_BASE=https://platform-api2.max.ru
# CATALOG_PATH=catalog.official.json     # обычно не нужен: бот сам берёт catalog.official.json, а если его нет — проектный
# DB_PATH=navigator.db                   # только имя файла БД; база всегда в DATA_DIR (/app/data на хостинге)
# DATA_DIR=/app/data                     # папка данных (по умолчанию /app/data, если она есть); относительный путь — от папки bot.py
# FAVORITES_PATH=favorites.json          # старый файл избранного: разово переносится в БД
# ADMIN_IDS=12345,67890                  # user_id администраторов (узнать: написать боту /myid); им доступна /stats
# WORKERS=4                              # число параллельных обработчиков
# Хэши SHA-256 сертификатов Минцифры (если заданы — при несовпадении bundle не используется):
# ROOT_CA_SHA256=
# SUB_CA_SHA256=
